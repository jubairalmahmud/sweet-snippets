APP_NAME="SK Love API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sklove
DB_USERNAME=root
DB_PASSWORD=

SKLOVE_ADMIN_NAME="SK Love Admin"
SKLOVE_ADMIN_EMAIL=admin@sklove.local
SKLOVE_ADMIN_PASSWORD=ChangeMe123!

SANCTUM_STATEFUL_DOMAINS=
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------
# Broadcasting (Pusher Channels) — realtime chat & live room
# Sign up free: https://dashboard.pusher.com  → Create Channels app
# ---------------------------------------------------------------
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# ---------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# Firebase Console → Project Settings → Service Accounts →
# "Generate new private key" → save JSON to the path below.
# ---------------------------------------------------------------
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_PROJECT_ID=

# Agora RTC token generation (server-side only)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600
